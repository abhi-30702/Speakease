<UserControl x:Class="WhisperFlowLocal.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <StackPanel Margin="32">
        <TextBlock Text="Settings" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" Margin="0,0,0,24"/>

        <Border Background="#1E293B" CornerRadius="8" Padding="24" MaxWidth="480" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Groq API" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <TextBlock Text="API Key" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ApiKeyBox"
                             Background="#0F172A" Foreground="#F8FAFC"
                             BorderBrush="#334155" BorderThickness="1"
                             Padding="8,6" Margin="0,0,0,16"
                             PasswordChanged="OnApiKeyChanged"/>

                <TextBlock Text="Model" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModel}"
                          Background="#0F172A" Foreground="#F8FAFC"
                          BorderBrush="#334155" Padding="8,6" Margin="0,0,0,24"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Background="#0d9488" Foreground="#F8FAFC"
                            BorderThickness="0" Padding="16,8" Cursor="Hand"/>
                    <TextBlock Text="{Binding SaveStatus}" Foreground="#2DD4BF"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
